# EYG Tire & Auto Care — editor configuration
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

[*.md]
# Two trailing spaces in Markdown are a hard line break. Never trim them.
trim_trailing_whitespace = false

[*.py]
indent_size = 4

[Makefile]
indent_style = tab

# ---------------------------------------------------------------------------
# Owned by devops. Deliberately NO `max_line_length` override for YAML in
# .github/workflows — GH Actions keys are long; 120 is the soft guide only.
# ---------------------------------------------------------------------------
