# ============================================================
# EYG TIRE & AUTO CARE — ENVIRONMENT
# Copy to `.env.local` for development, `.env` for production.
# NEVER commit a real secret. Every var below is validated at boot by
# `src/lib/env.ts` — the app refuses to start with an invalid combination.
# ============================================================

# ---------- Core ----------
NODE_ENV=development
# Public origin. No trailing slash. Used for canonical tags, sitemap, OG images.
# REQUIRED IN PRODUCTION — the CSRF origin allowlist is derived from it, so the
# app refuses to boot without it.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Extra origins allowed to POST/PUT/PATCH/DELETE (Vercel preview domains, a
# future custom domain). Comma-separated. `NEXT_PUBLIC_SITE_URL` is always
# allowed. Plaintext http:// is ignored in production.
CSRF_ALLOWED_ORIGINS=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# ---------- Database ----------
# Postgres 16+. docker compose up -d gives you a local one.
#
# ⚠️  ON VERCEL (or any serverless host) THIS MUST BE A POOLED URL.
#     Serverless functions open a fresh Postgres connection per invocation, which
#     exhausts the provider's connection limit within minutes and takes the site
#     down with "too many connections" — the single most common way a Prisma +
#     Vercel app dies in production.
#
#     Neon:      the "-pooler" host.            postgresql://USER:PASS@ep-xxx-pooler.REGION.aws.neon.tech/DB?sslmode=require
#     Supabase:  append ?pgbouncer=true&connection_limit=1
#     Railway / Render (a real VM):  a plain URL is fine, use ?connection_limit=5
#
#     `scripts/predeploy-check.mjs` warns if this is not set at all.
DATABASE_URL=postgresql://eyg:eyg_dev_password@localhost:5432/eyg?schema=public

# A SEPARATE, non-pooled URL used only by `prisma migrate deploy`. Migrations
# need a direct connection — they use prepared statements and advisory locks,
# which a transaction pooler breaks. Leave empty only if you are not using
# Prisma migrations (then set it equal to DATABASE_URL locally).
DIRECT_URL=

# ---------- Secrets (generate: openssl rand -base64 48) ----------
# Signs session JWTs. ROTATING THIS LOGS EVERYONE OUT — intentional.
AUTH_SECRET=
# 32-byte hex used to encrypt PII columns at rest.
PII_ENCRYPTION_KEY=
# Signs + verifies webhooks from Twilio/Resend.
WEBHOOK_SIGNING_SECRET=

# ---------- Rate limiting ----------
# Upstash Redis REST. Without it the app falls back to a Postgres counter,
# which is correct but slower under load.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Requests allowed per window per IP for public write endpoints.
RATE_LIMIT_PUBLIC_PER_MINUTE=10
RATE_LIMIT_BOOKING_PER_HOUR=8
RATE_LIMIT_QUOTE_PER_HOUR=12
RATE_LIMIT_LOGIN_PER_15MIN=8

# ---------- Bot protection ----------
# Arithmetic challenge (no third-party dependency, works offline).
CAPTCHA_ENABLED=true
CAPTCHA_TTL_SECONDS=600
# Optional Turnstile. If set, it takes priority over the math challenge.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---------- Transactional email ----------
# Resend (recommended) — set RESEND_API_KEY; otherwise configure SMTP_* below.
RESEND_API_KEY=
EMAIL_FROM="EYG Tire & Auto Care <bookings@eygtireautocare.ph>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# ---------- SMS ----------
# Twilio for booking confirmations. Without it, notifications log as "skipped"
# and the site still works.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---------- WhatsApp Cloud API (optional; wa.me links work without it) ----------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# ---------- Reviews (social proof) ----------
GOOGLE_PLACE_ID=
GOOGLE_API_KEY=
FACEBOOK_PAGE_ACCESS_TOKEN=

# ---------- Observability ----------
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
LOG_LEVEL=info
NEXT_PUBLIC_APP_VERSION=1.0.0

# ---------- Admin security ----------
# Comma-separated CIDR/IP allowlist for /admin. Empty = disabled (open, dev only).
ADMIN_IP_ALLOWLIST=
