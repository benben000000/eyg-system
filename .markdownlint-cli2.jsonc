{
  // MD013 (line length) is disabled: 342 of the over-length lines in docs/brand
  // are markdown table rows, which physically cannot be wrapped. Every other
  // rule stays on.
  "MD013": false,
  "MD024": { "siblings_only": true },
  "MD033": { "allowed_elements": ["br", "img", "kbd", "sub", "sup", "details", "summary"] },
  "MD041": false
}