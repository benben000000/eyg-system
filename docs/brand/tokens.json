{
  "$schema": "https://design-tokens.org/schema.json",
  "name": "EYG Tire & Auto Care",
  "version": "1.0.0",
  "description": "Machine-readable dump of the EYG design tokens. MIRRORS src/app/globals.css @theme exactly. globals.css is the contract; if this file and globals.css ever disagree, globals.css wins and this file is a bug.",
  "source": {
    "tokens": "src/app/globals.css",
    "facts": "src/config/site.ts",
    "logo": "brand/raw/eyg-profile.jpg",
    "colorExtraction": "Brand yellow #FCC605 = modal colour of the official 720x720 profile mark (2.7% of pixels, range #987603 -> #FFE141). Ink #06060A measured as the lockup backdrop."
  },
  "color": {
    "brand": {
      "$description": "Eylan yellow. Primary action / accent / speed-stripe.",
      "50": "#fffaeb",
      "100": "#fff1c2",
      "200": "#ffe684",
      "300": "#ffdc47",
      "400": "#ffd11a",
      "500": "#fcc605",
      "600": "#d9a800",
      "700": "#a67f00",
      "800": "#6d5300",
      "900": "#3a2c00"
    },
    "ink": {
      "$description": "Motorsport near-black with a cool violet cast. Dark surfaces, body text.",
      "50": "#f6f6f7",
      "100": "#e3e3e6",
      "200": "#c7c7cd",
      "300": "#a0a0a9",
      "400": "#71717e",
      "500": "#52525e",
      "600": "#3d3d47",
      "700": "#2a2a32",
      "800": "#17171d",
      "900": "#0e0e12",
      "950": "#06060a"
    },
    "racing": {
      "$description": "Urgent / clearance / error. Never decorative.",
      "50": "#fef2f2",
      "100": "#fee2e2",
      "200": "#fecaca",
      "300": "#fca5a5",
      "400": "#f87171",
      "500": "#ef4444",
      "600": "#dc2626",
      "700": "#b91c1c",
      "800": "#991b1b",
      "900": "#7f1d1d"
    },
    "pit": {
      "$description": "Confirmed / open / success.",
      "50": "#f0fdf4",
      "100": "#dcfce7",
      "200": "#bbf7d0",
      "300": "#86efac",
      "400": "#4ade80",
      "500": "#22c55e",
      "600": "#16a34a",
      "700": "#15803d",
      "800": "#166534",
      "900": "#14532d"
    },
    "semantic": {
      "$description": "Light theme (default) values. [data-theme=dark] overrides are listed under theme.dark.",
      "background": "#ffffff",
      "foreground": "{color.ink.950}",
      "surface": "#ffffff",
      "surface-muted": "#f6f6f7",
      "surface-inverse": "{color.ink.950}",
      "border": "#e3e3e6",
      "border-strong": "#c7c7cd",
      "muted-foreground": "#52525e",
      "ring": "{color.brand.500}",
      "primary": "{color.ink.950}",
      "primary-foreground": "#ffffff",
      "accent": "{color.brand.500}",
      "accent-foreground": "{color.ink.950}",
      "destructive": "{color.racing.600}",
      "destructive-foreground": "#ffffff",
      "success": "{color.pit.600}"
    }
  },
  "theme": {
    "default": "dark",
    "supported": ["dark", "light"],
    "attribute": "data-theme",
    "dark": {
      "$description": "EYG's primary presentation mode: the mark is a yellow-on-black lockup, so the site leads dark.",
      "background": "{color.ink.950}",
      "foreground": "#ffffff",
      "surface": "{color.ink.900}",
      "surface-muted": "{color.ink.800}",
      "surface-inverse": "#ffffff",
      "border": "#2a2a32",
      "border-strong": "#3d3d47",
      "muted-foreground": "{color.ink.300}",
      "primary": "{color.brand.500}",
      "primary-foreground": "{color.ink.950}",
      "accent": "{color.brand.500}",
      "accent-foreground": "{color.ink.950}",
      "shadow-plate": "0 1px 2px rgb(0 0 0 / 0.5), 0 4px 14px rgb(0 0 0 / 0.4)",
      "shadow-lift": "0 2px 4px rgb(0 0 0 / 0.5), 0 12px 32px rgb(0 0 0 / 0.5)",
      "color-scheme": "dark"
    },
    "light": { "color-scheme": "light", "$note": "All other light values come from the semantic defaults above." }
  },
  "font": {
    "display": {
      "$value": "var(--font-saira), \"Arial Black\", system-ui, sans-serif",
      "family": "Saira",
      "weights": [800, 900],
      "styles": ["normal", "italic"],
      "role": "Headlines, display type, wordmark stand-ins, numerals in price callouts."
    },
    "sans": {
      "$value": "var(--font-barlow), system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "family": "Barlow",
      "role": "Body copy, UI, forms, navigation, all long-form reading."
    },
    "mono": {
      "$value": "var(--font-barlow-mono), ui-monospace, \"SFMono-Regular\", monospace",
      "family": "Barlow Mono",
      "role": "Booking references (EYG-XXXX), VINs, plate numbers, diagnostic codes, timestamps."
    },
    "loading": "Self-hosted via next/font. No third-party font CDN at runtime."
  },
  "fontSize": {
    "eyebrow": {
      "size": "0.75rem",
      "lineHeight": "1rem",
      "letterSpacing": "0.16em",
      "fontWeight": 700,
      "transform": "uppercase",
      "class": "eyg-eyebrow"
    },
    "display-1": {
      "size": "clamp(2.5rem, 1.4rem + 5.2vw, 5.5rem)",
      "lineHeight": 0.92,
      "letterSpacing": "-0.03em",
      "fontWeight": 900,
      "class": "text-display-1"
    },
    "display-2": {
      "size": "clamp(2rem, 1.3rem + 3.4vw, 3.75rem)",
      "lineHeight": 0.96,
      "letterSpacing": "-0.025em",
      "fontWeight": 900,
      "class": "text-display-2"
    },
    "h1": {
      "size": "clamp(1.875rem, 1.4rem + 2.2vw, 3rem)",
      "lineHeight": 1.06,
      "letterSpacing": "-0.02em",
      "fontWeight": 800,
      "class": "text-h1"
    },
    "h2": {
      "size": "clamp(1.5rem, 1.25rem + 1.2vw, 2.125rem)",
      "lineHeight": 1.14,
      "letterSpacing": "-0.015em",
      "fontWeight": 800,
      "class": "text-h2"
    },
    "h3": {
      "size": "clamp(1.25rem, 1.12rem + 0.6vw, 1.625rem)",
      "lineHeight": 1.2,
      "letterSpacing": "-0.01em",
      "fontWeight": 700,
      "class": "text-h3"
    },
    "body-lg": { "size": "1.0625rem", "lineHeight": 1.65, "class": "text-body-lg" },
    "body": { "size": "1rem", "lineHeight": 1.6, "class": "text-base" }
  },
  "easing": {
    "rapid": { "value": "cubic-bezier(0.2, 0, 0, 1)", "class": "ease-rapid", "use": "Micro-feedback: hover, press, 120-200ms." },
    "snap": { "value": "cubic-bezier(0.16, 1, 0.3, 1)", "class": "ease-snap", "use": "Entrances and layout reveals. The default for anything entering." },
    "brake": { "value": "cubic-bezier(0.5, 0, 0.75, 0)", "class": "ease-brake", "use": "Exits only. Never for entrances." }
  },
  "radius": {
    "eyebrow": { "value": "2px", "class": "rounded-eyebrow", "use": "Motorsplay squareness. Eyebrows, chips, tags, small labels. Also the focus-ring radius." },
    "card": { "value": "12px", "class": "rounded-card", "use": "Default for cards, tiles, inputs, list rows." },
    "panel": { "value": "18px", "class": "rounded-panel", "use": "Large panels: hero, modal, drawer, section shells." },
    "pill": { "value": "999px", "class": "rounded-pill", "use": "Status pills and tags only. Never for cards or panels." }
  },
  "shadow": {
    "plate": { "value": "0 1px 2px rgb(6 6 10 / 0.06), 0 4px 14px rgb(6 6 10 / 0.06)", "use": "Resting elevation for cards on a light field." },
    "lift": { "value": "0 2px 4px rgb(6 6 10 / 0.06), 0 12px 32px rgb(6 6 10 / 0.1)", "use": "Hover, focus-within, open menus, drag." },
    "cta": { "value": "0 1px 0 0 rgb(255 255 255 / 0.35) inset, 0 6px 0 0 var(--color-brand-700), 0 12px 24px -6px rgb(6 6 10 / 0.35)", "use": "Primary yellow call-to-action button at rest. Solid 3D edge." },
    "cta-hover": { "value": "0 1px 0 0 rgb(255 255 255 / 0.4) inset, 0 4px 0 0 var(--color-brand-700), 0 10px 20px -6px rgb(6 6 10 / 0.4)", "use": "Primary CTA pressed/hovered: the edge compresses 6px -> 4px." }
  },
  "layout": {
    "container-page": "76rem",
    "container-prose": "44rem",
    "header-height": "4rem",
    "mobile-action-bar-height": "4.25rem"
  },
  "zIndex": {
    "base": 0,
    "raised": 10,
    "sticky-header": 40,
    "dropdown": 50,
    "overlay": 60,
    "modal": 70,
    "toast": 80,
    "mobile-bar": 90,
    "$note": "Never use a raw z-index in a component. The mobile action bar (90) is always the highest chrome so the phone number is never occluded."
  },
  "motion": {
    "reducedMotion": {
      "query": "@media (prefers-reduced-motion: reduce)",
      "effect": "animation-duration 0.01ms, animation-iteration-count 1, transition-duration 0.01ms, scroll-behavior auto",
      "rule": "Global and unconditional in globals.css. Components must not opt out with !important."
    },
    "durations": {
      "micro": "120-180ms",
      "control": "180-260ms",
      "panel": "280-420ms"
    }
  },
  "utility": {
    "eyg-stripe": {
      "$description": "The signature speed-stripe: a 4px angled bar under an element.",
      "pseudo": "::after",
      "inset-inline": "0",
      "bottom": "-0.5rem",
      "height": "4px",
      "background": "linear-gradient(90deg, #fcc605 0%, #ffdc47 60%, transparent 100%)",
      "clip-path": "polygon(0 0, 100% 0, 96% 100%, 0 100%)",
      "class": "eyg-stripe"
    },
    "eyg-hazard": {
      "$description": "45-degree hazard hatching. URGENCY ONLY: clearance stock, closing soon, roadside callout.",
      "background-image": "repeating-linear-gradient(-45deg, #fcc605 0 12px, transparent 12px 24px)",
      "class": "eyg-hazard"
    },
    "eyg-checker": {
      "$description": "16px micro-tile in --color-border-strong for section dividers and tread motifs. Implemented as a conic-gradient of four quadrants, so tiles repeat with identical orientation; treat it as a fine pinwheel texture, not a true alternating checkerboard.",
      "background-image": "conic-gradient(#c7c7cd 25%, transparent 0 50%, #c7c7cd 0 75%, transparent 0)",
      "background-size": "16px 16px",
      "class": "eyg-checker"
    },
    "eyg-eyebrow": {
      "$description": "Uppercase tracked label. Font --font-sans, 0.75rem, 700, 0.16em, uppercase.",
      "class": "eyg-eyebrow"
    },
    "tabular": { "class": "tabular", "use": "font-variant-numeric: tabular-nums. Mandatory in any price or quantity table so digits do not jitter." },
    "no-scrollbar": { "class": "no-scrollbar", "use": "Hide a scrollbar on a horizontally scrollable strip without losing scrollability." },
    "pb-action-bar": { "class": "pb-action-bar", "use": "Pad the bottom of the page so the mobile action bar never covers the footer." },
    "pt-safe": { "class": "pt-safe", "use": "Respect the notch / status bar with env(safe-area-inset-top)." }
  },
  "focus": {
    "selector": ":focus-visible",
    "outline": "3px solid #fcc605",
    "outline-offset": "2px",
    "border-radius": "2px",
    "rule": "Keyboard focus only. Never remove focus without a visible replacement."
  },
  "selection": { "background": "#fcc605", "color": "#06060a" },
  "accessibility": {
    "target": "WCAG 2.2 AA",
    "minContrastBody": 4.5,
    "minContrastLarge": 3,
    "minContrastUI": 3,
    "minTargetSize": "24x24 CSS px (WCAG 2.2 AA); 44x44 for the phone number"
  }
}