{
  "name": "eyg-tire-auto-care",
  "version": "1.0.0",
  "private": true,
  "description": "EYG Tire & Auto Care — Balanga City, Bataan. Brand guideline + production website.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "check:boundaries": "node scripts/check-client-boundaries.mjs",
    "check:vercel": "node scripts/check-vercel-config.mjs",
    "check:docker-context": "node scripts/check-docker-context.mjs",
    "check:stubs": "node scripts/check-stub-lengths.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --require ./scripts/register-server-only.cjs prisma/seed.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "lint:md": "markdownlint-cli2 \"docs/**/*.md\"",
    "verify:invariants": "node scripts/verify-invariants.mjs",
    "verify:secrets:baseline": "node scripts/regenerate-gitleaks-baseline.mjs"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@sentry/nextjs": "^11.2.0",
    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.34.3",
    "argon2": "^0.45.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "es-abstract": "^1.24.2",
    "eslint-plugin-react": "^7.37.5",
    "framer-motion": "^13.5.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.49.0",
    "next": "15.5.27",
    "next-themes": "^0.4.4",
    "nodemailer": "^10.0.13",
    "object.fromentries": "^2.0.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.32.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "twilio": "^6.1.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.13.1",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.20.0",
    "eslint-config-next": "15.5.27",
    "jsdom": "^26.0.0",
    "markdownlint-cli2": "^0.17.2",
    "prisma": "^6.19.3",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "5.8.2",
    "vite": "^6.0.11",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=22.21.1"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "argon2@0.41.1": true,
    "sharp@0.33.5": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "@sentry/cli@2.39.1": true,
    "unrs-resolver@1.12.2": true
  }
}
